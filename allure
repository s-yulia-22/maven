<plugin>
    <groupId>net.masterthought</groupId>
    <artifactId>maven-cucumber-reporting</artifactId>
    <version>5.8.5</version>
    <executions>
        <execution>
            <id>generate-cucumber-html-report</id>
            <phase>verify</phase>
            <goals>
                <goal>generate</goal>
            </goals>
            <configuration>
                <projectName>AI-Test</projectName>
                <jsonFiles>
                    <param>target/cucumber.json</param>
                </jsonFiles>
                <outputDirectory>target/cucumber-reports</outputDirectory>
            </configuration>
        </execution>
    </executions>
</plugin>
