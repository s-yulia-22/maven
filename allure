for (WebElement card : cards) {
    try {
        WebElement cardHeader = card.findElement(By.cssSelector("h5.card-title span"));
        System.out.println("Title: " + cardHeader.getText());

        if (cardHeader.getText().contains(title)) {
            System.out.println("App was found");
            WebElement startButton = card.findElement(By.cssSelector("button[data-bs-title='Start App']"));
            wait.until(ExpectedConditions.elementToBeClickable(startButton)).click();
            System.out.println("App was clicked");
            return; // теперь всё ок – выйдем только если нашли
        }

    } catch (NoSuchElementException e) {
        System.out.println("Header or button not found in one of the cards");
        // можно продолжать — это нормально
    }
}
throw new NoSuchElementException("App with title '" + title + "' not found.");
