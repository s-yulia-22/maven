@FindBy(css = "a[role='button'][data-bs-toggle='dropdown']") // кнопка с аватаркой
private WebElement userMenuButton;

@FindBy(xpath = "//a[text()='Ausloggen']") // кнопка Ausloggen
private WebElement logoutButton;

public void clickUserMenu() {
    wait.until(ExpectedConditions.elementToBeClickable(userMenuButton)).click();
}

public void clickLogout(String buttonLabel) {
    wait.until(ExpectedConditions.elementToBeClickable(logoutButton)).click();
}
//////////////////

@When("the user opens the user menu")
public void openUserMenu() {
    homePage.clickUserMenu();
}

@And("the user clicks the {string} button")
public void clickLogoutButton(String buttonLabel) {
    homePage.clickLogout(buttonLabel);
}

@Then("the user should see the login page")
public void verifyRedirectToLogin() {
    Assert.assertTrue(loginPage.isLoginPageDisplayed());
}


//////////////////

@FindBy(id = "username") // или любой другой уникальный элемент на странице логина
private WebElement usernameInput;

public boolean isLoginPageDisplayed() {
    return wait.until(ExpectedConditions.visibilityOf(usernameInput)).isDisplayed();
}


