public boolean isInvalidCredentialsErrorVisible() {
    try {
        wait.until(ExpectedConditions.visibilityOf(usernameErrorMessage));
        return usernameErrorMessage.isDisplayed()
               && usernameErrorMessage.getText().contains("Kein Konto mit diesem Benutzernamen gefunden");
    } catch (TimeoutException e) {
        return false;
    }
}
